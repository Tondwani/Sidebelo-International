# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env
.env.*
!.env.example

# Common ignores
node_modules/
.next/
.DS_Store

# Ignore all Markdown documentation files (including Pocketbase changelogs/licenses)
*.md
**/pocketbase_*/*.md

# Ignore the Pocketbase Windows binary application executable
**/pocketbase_*/pocketbase.exe
**/pocketbase_*/pocketbase

# Force include Pocketbase database and migrations so they are pushed to GitHub
!pocketbase_*/pb_data/
!pocketbase_*/pb_data/**
!pocketbase_*/pb_migrations/
!pocketbase_*/pb_migrations/**